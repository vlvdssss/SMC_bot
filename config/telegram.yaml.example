# Конфигурация Telegram уведомлений
# Копируйте в config/telegram.yaml и настройте

telegram:
  enabled: false  # true для активации
  bot_token: ""   # Токен от @BotFather
  chat_id: ""     # Ваш Chat ID от @userinfobot
  enable_bot: true  # Включить интерактивного бота с кнопками
  
  # Какие события отправлять
  notify:
    startup: true           # Запуск бота
    shutdown: true          # Остановка бота
    trade_opened: true      # Открытие сделки
    trade_closed: true      # Закрытие сделки
    daily_report: true      # Дневной отчет (23:55)
    alerts: true            # Алерты (drawdown, losses и т.д.)
    
  # Минимальный уровень для алертов (INFO, WARNING, ERROR, CRITICAL)
  alert_min_level: "WARNING"
